---
import EditionLayout from '../../../layouts/EditionLayout.astro';
import Icon from '../../../components/Icon.astro';
import { edition2027 as edition } from '../../../data/edition-2027';
---
<EditionLayout edition={edition} activePage="program" title="Challenge">
  <section class="page-intro section"><div class="container"><p class="section-kicker">Program · Competition</p><h1>Challenge</h1><p class="lead">Replace with the official challenge name, objective and target audience. If an edition has no challenge, remove this item from the Program submenu.</p></div></section>
  <section class="section section--alt"><div class="container"><div class="section__heading"><h2>Challenge Overview</h2><p>Introduce the challenge before participants move into rules, dates and evaluation details.</p></div><div class="grid grid--2"><article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="trophy" /></span><h3>About the challenge</h3></div><p>Problem statement, dataset and expected solution type placeholder.</p></article><article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="upload" /></span><h3>How to participate</h3></div><p>Eligibility, team rules, registration and submission platform placeholder.</p><p class="card__action"><a class="btn btn--primary" href="#">Challenge platform ↗</a></p></article></div></div></section>
  <section class="section"><div class="container"><div class="section__heading"><h2>Timeline</h2><p>Include only milestones participants must act on.</p></div><div class="timeline"><div class="timeline__item"><div class="timeline__date">Month 00</div><div><strong>Registration opens</strong><span>Details placeholder</span></div></div><div class="timeline__item"><div class="timeline__date">Month 00</div><div><strong>Submission deadline</strong><span>Details placeholder</span></div></div><div class="timeline__item"><div class="timeline__date">Month 00</div><div><strong>Results</strong><span>Details placeholder</span></div></div></div></div></section>
  <section class="section section--alt"><div class="container"><div class="section__heading"><h2>Rules, evaluation &amp; prizes</h2></div><div class="prose"><h3>Dataset</h3><p>Dataset access, license and limitations placeholder.</p><h3>Evaluation</h3><p>Metrics and ranking procedure placeholder.</p><h3>Prizes / recognition</h3><p>Prize or recognition placeholder.</p><h3>Organizers</h3><p>Organizer Name — Institution<br/>Organizer Name — Institution</p></div></div></section>
</EditionLayout>
