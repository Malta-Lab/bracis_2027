---
import EditionLayout from '../../layouts/EditionLayout.astro';
import { edition2027 as edition } from '../../data/edition-2027';
import { withBase } from '../../utils/paths';
const cityPhotos = [
  /* FOTOS DA CIDADE: JPG/WebP 1600×1000 px (8:5), idealmente até 350 KB cada.
     Use 3–6 fotos horizontais, sem texto embutido e com autorização de uso.
     VÍDEO: informe `video` (MP4 H.264, caminho local ou URL direta) e use `src` como imagem de capa (poster).
     Toca sem som, em loop, apenas quando o slide está visível.
     Dropbox: use o link compartilhado trocando dl=0 por raw=1. */
  { src: '/assets/2027/city-video-cepuc-poster.jpg', video: 'https://www.dropbox.com/scl/fi/ne85l5wrdiwbiuzljceza/Video-Comercial-CEPUC.mp4?rlkey=7luqjk3x4s8ajo0qsx8pvfqxp&raw=1', alt: 'Video presenting the PUCRS Events Center (CEPUC)' },
  { src: '/assets/2027/city-1-pucrs-sign-palms.jpg', alt: 'PUCRS letters sign among palm trees on the PUCRS campus' },
  { src: '/assets/2027/city-2-pucrs-campus-aerial.jpg', alt: 'Aerial view of the PUCRS campus in Porto Alegre' },
  { src: '/assets/2027/city-3-pucrs-sign-garden.jpg', alt: 'PUCRS letters sign in a campus garden' },
];
const sponsorGroups = [
  { title: 'Promotion', size: 'medium', logos: ['Institution / logo'] },
  { title: 'Organized by', size: 'medium', logos: ['Institution / logo', 'Institution / logo'] },
  { title: 'Supporting Agency', size: 'medium', logos: ['Institution / logo'] },
  { title: 'Institutional Support', size: 'small', logos: ['Institution / logo', 'Institution / logo'] },
  { title: 'Platinum Sponsor', size: 'large', logos: ['Sponsor / logo'] },
  { title: 'Elite Sponsor', size: 'medium', logos: ['Sponsor / logo', 'Sponsor / logo'] },
  { title: 'Premium Sponsor', size: 'small', logos: ['Sponsor / logo', 'Sponsor / logo', 'Sponsor / logo'] },
];
---
<EditionLayout edition={edition} activePage="home">
  <section class="section city-section">
    <div class="container">
      <div class="section__heading section__heading--wide"><p class="section-kicker">Host city</p><h2>Welcome to {edition.city}</h2></div>
      <div class="city-intro-grid">
        <div class="city-carousel" data-carousel aria-label={`Photos of ${edition.city}`}>
          <div class="city-carousel__viewport">
            {cityPhotos.map((photo, index) => <figure class={`city-carousel__slide ${index === 0 ? 'is-active' : ''}`} data-slide aria-hidden={index === 0 ? 'false' : 'true'}>{photo.video ? <video src={withBase(photo.video)} poster={withBase(photo.src)} aria-label={photo.alt} width="1600" height="1000" muted loop playsinline controls preload="metadata" style="display:block;width:100%;height:100%;object-fit:cover"></video> : <img src={withBase(photo.src)} alt={photo.alt} width="1600" height="1000" loading={index === 0 ? 'eager' : 'lazy'} />}</figure>)}
          </div>
          <div class="city-carousel__controls">
            <button class="carousel-button" type="button" data-prev aria-label="Previous photo">←</button>
            <div class="carousel-dots" aria-label="Choose photo">{cityPhotos.map((_, index) => <button class={index === 0 ? 'is-active' : ''} type="button" data-dot={index} aria-label={`Show photo ${index + 1}`}></button>)}</div>
            <button class="carousel-button" type="button" data-next aria-label="Next photo">→</button>
          </div>
        </div>
        <div class="city-copy">
          <!-- TEXTO: 120–220 palavras. Fale de identidade, atrações, gastronomia/natureza/cultura
               e informações úteis; evite transformar a home em um guia turístico extenso. -->
          <p><strong>Porto Alegre is the capital of Rio Grande do Sul, Brazil's southernmost state.</strong> Home to about 1.3 million people, the city lies on the eastern shore of the Guaíba, where several rivers meet, and its west-facing waterfront makes watching the sunset over the water a local habit. It is also a centre of gaúcho culture, known for churrasco and chimarrão, the hot yerba-mate infusion shared throughout the day.</p>
          <p>The Usina do Gasômetro, a former power plant from 1928 whose chimney rises over the shore, is the city's best-known sunset spot and the image in the BRACIS 2027 logo. From there, the Orla do Guaíba waterfront park runs south along the water. In the historic centre, the Mercado Público (1869) and the Casa de Cultura Mario Quintana are worth a visit, and Parque Farroupilha, known as Redenção, is the city's best-loved park.</p>
          <a class="text-link" href={withBase(`/${edition.year}/attending/`)}>Plan your visit →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
     CALL FOR PAPERS — MAIN CONFERENCE
     Este bloco apenas destaca o CFP da BRACIS na Home.
     O conteúdo completo deve permanecer na página do evento.
     ========================================================= -->
  <section class="cfp-highlight">
    <div class="container">
      <div class="cfp-highlight__card">
        <div class="cfp-highlight__content">
          <p class="eyebrow">CALL FOR PAPERS</p>

          <h2>Contribute to BRACIS {edition.year}</h2>

          <p>
            Submit your work to the Brazilian Conference on Intelligent Systems.
            Explore the topics of interest, submission guidelines, decision process
            and important dates for the main conference.
          </p>
        </div>

        <div class="cfp-highlight__action">
          <a
            class="button button--primary"
            href={withBase(`/${edition.year}/events/bracis/`)}
          >
            View Call for Papers
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section sponsors-section section--alt" id="sponsors">
    <div class="container">
      <div class="section__heading"><p class="section-kicker">Partners</p><h2>Promotion, organization &amp; sponsors</h2><p><!-- LOGOS: SVG preferido ou PNG transparente 800×400 px, idealmente até 250 KB. Preserve proporção e respiro da marca. --></p></div>
      <div class="sponsor-groups">
        {sponsorGroups.map((group) => <section class={`sponsor-group sponsor-group--${group.size}`}><h3>{group.title}</h3><div class="sponsor-logo-grid">{group.logos.map((label) => <div class="sponsor-logo-placeholder" aria-label={label}>{label}</div>)}</div></section>)}
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-carousel]').forEach((carousel) => {
      const slides = [...carousel.querySelectorAll('[data-slide]')];
      const dots = [...carousel.querySelectorAll('[data-dot]')];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = 0;
      const show = (index) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === current);
          slide.setAttribute('aria-hidden', String(i !== current));
          // Only the visible slide's video plays; the others stay paused.
          const video = slide.querySelector('video');
          if (video && i === current && !reduceMotion) video.play().catch(() => {});
          else video?.pause();
        });
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
      };
      carousel.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
      carousel.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
      show(current);
    });
  </script>
</EditionLayout>
