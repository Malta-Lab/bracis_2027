---
import EditionLayout from '../../layouts/EditionLayout.astro';
import Icon from '../../components/Icon.astro';
import { edition2026 as edition } from '../../data/edition-2026';
import { withBase } from '../../utils/paths';

const accommodation = [
  { title: 'Hotel Option 1', text: 'Area / distance from venue · negotiated rate or booking note placeholder.' },
  { title: 'Hotel Option 2', text: 'Area / distance from venue · category and booking note placeholder.' },
  { title: 'Hotel Option 3', text: 'Area / distance from venue · category and booking note placeholder.' },
];
const dining = [
  { title: 'Restaurant Option 1', text: 'Cuisine · distance from venue · opening-hours note placeholder.' },
  { title: 'Restaurant Option 2', text: 'Cuisine · distance from venue · dietary options placeholder.' },
  { title: 'Restaurant Option 3', text: 'Cuisine · neighborhood / practical note placeholder.' },
];
const hospitals = [
  { title: 'Hospital / Emergency Option 1', text: 'Address · approximate distance · emergency service note placeholder.' },
  { title: 'Hospital / Emergency Option 2', text: 'Address · approximate distance · service note placeholder.' },
];
---
<EditionLayout edition={edition} activePage="attending" title="Attending">
  <!-- HIERARQUIA PADRÃO: um único H1 por página; H2 para seções; H3 para cards. -->
  <section class="page-intro section">
    <div class="container">
      <p class="section-kicker">Plan your trip</p>
      <h1>Attending</h1>
      <p class="lead">Practical information for arriving in {edition.city}, reaching the conference venue, finding accommodation, dining nearby and accessing emergency services.</p>
    </div>
  </section>

  <section class="section section--alt" id="venue">
    <div class="container">
      <div class="section__heading">
        <h2>Venue</h2>
        <p>The location should be immediately understandable: photo, map, name, address and a short practical description.</p>
      </div>
      <div class="venue-grid">
        <div class="venue-media">
          <!-- FOTO DO LOCAL: horizontal 1600×1000 px (8:5), JPG/WebP, idealmente ≤350 KB. -->
          <img src={withBase(edition.venuePhoto)} alt={`Replace with a photo of ${edition.venue}`} width="1600" height="1000" loading="lazy" />
        </div>
        <div class="venue-map">
          <!-- GOOGLE MAPS: substitua mapEmbedUrl em src/data/edition-AAAA.ts para o local da nova edição. -->
          <iframe src={edition.mapEmbedUrl} title={`Map showing ${edition.venue}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
      <div class="venue-details">
        <div><p class="section-kicker">Conference venue</p><h3>{edition.venue}</h3><p class="venue-address"><Icon name="pin" size={18}/>{edition.venueAddress}</p></div>
        <p>{edition.venueDescription}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__heading">
        <h2>Getting to the City</h2>
        <p>Give participants the two most common arrival routes and only the information needed to make a travel decision.</p>
      </div>
      <div class="grid grid--2">
        <article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="plane" /></span><h3>By Plane</h3></div><p>Nearest airport, airport code, approximate distance/time to the central area and key domestic connections placeholder.</p></article>
        <article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="bus" /></span><h3>By Bus</h3></div><p>Main intercity bus terminal, routes commonly used by attendees and approximate distance/time to the venue placeholder.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section__heading">
        <h2>Getting to the Venue</h2>
        <p>Replace with a brief orientation on the safest and most practical ways to reach the venue, including typical travel times when useful.</p>
      </div>
      <div class="grid grid--3">
        <article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="taxi" /></span><h3>Ride-hailing / Taxi Apps</h3></div><p>Recommended apps, official taxi information, pickup/drop-off point and approximate travel-time placeholder.</p></article>
        <article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="bus" /></span><h3>Bus</h3></div><p>Useful lines/stops, payment method, frequency and walking distance from the closest stop placeholder.</p></article>
        <article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="car" /></span><h3>Car Rental</h3></div><p>Rental guidance, parking availability/cost and any access restrictions around the venue placeholder.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__heading">
        <h2>Leaving the Venue</h2>
        <p>Use this area for evening transport guidance, pickup points and any details that differ after conference hours.</p>
      </div>
      <div class="grid grid--2">
        <article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="taxi" /></span><h3>Ride-hailing / Taxi Apps</h3></div><p>Designated pickup location, practical safety guidance and expected availability after the final sessions placeholder.</p></article>
        <article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="bus" /></span><h3>Bus</h3></div><p>Last useful departures, nearest stop and links to official public-transport information placeholder.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section__heading">
        <h2>Accommodation</h2>
        <p>Briefly explain recommended areas and identify official/negotiated conference rates when available.</p>
      </div>
      <div class="grid grid--3">{accommodation.map((item)=><article class="card option-card"><div class="card__title"><span class="card-icon"><Icon name="hotel" /></span><h3>{item.title}</h3></div><p>{item.text}</p><a class="text-link" href="#">Hotel website <Icon name="external" size={15}/></a></article>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__heading">
        <h2>Nearby Dining</h2>
        <p>Prioritize options close to the venue and include dietary information when it is genuinely useful.</p>
      </div>
      <div class="grid grid--3">{dining.map((item)=><article class="card option-card"><div class="card__title"><span class="card-icon"><Icon name="dining" /></span><h3>{item.title}</h3></div><p>{item.text}</p><a class="text-link" href="#">Directions <Icon name="external" size={15}/></a></article>)}</div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section__heading">
        <h2>Hospitals &amp; Emergencies</h2>
        <p>List only reliable emergency options and the relevant local emergency numbers.</p>
      </div>
      <div class="grid grid--2">{hospitals.map((item)=><article class="card option-card"><div class="card__title"><span class="card-icon"><Icon name="hospital" /></span><h3>{item.title}</h3></div><p>{item.text}</p><a class="text-link" href="#">Open map <Icon name="external" size={15}/></a></article>)}</div>
    </div>
  </section>
</EditionLayout>
