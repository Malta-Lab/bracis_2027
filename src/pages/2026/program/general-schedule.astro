---
import EditionLayout from '../../../layouts/EditionLayout.astro';
import Icon from '../../../components/Icon.astro';
import { edition2026 as edition } from '../../../data/edition-2026';
import { withBase } from '../../../utils/paths';
const days=['Monday, October 19','Tuesday, October 20','Wednesday, October 21','Thursday, October 22'];
---
<EditionLayout edition={edition} activePage="program" title="General Schedule">
  <section class="page-intro section"><div class="container"><p class="section-kicker">Program</p><h1>General Schedule</h1><p class="lead">Publish the conference-wide overview first; add rooms and detailed session information as soon as confirmed. Avoid using a PDF as the only source of schedule information.</p></div></section>
  <section class="section section--alt"><div class="container"><div class="program-notice"><Icon name="info" size={19}/><div><strong>Program status:</strong> replace with “Preliminary program”, “Updated on [date]” or another clear status. <a href="#">Download PDF (optional) ↗</a></div></div><div class="program-days">{days.map((day)=><section class="program-day"><h2><Icon name="calendar" size={18}/>{day}</h2><div class="schedule-row"><time>09:00</time><div><strong>Session / activity</strong><span>Room · Speaker or chair</span></div></div><div class="schedule-row"><time>10:30</time><div><strong>Session / activity</strong><span>Room · Speaker or chair</span></div></div><div class="schedule-row"><time>14:00</time><div><strong>Session / activity</strong><span>Room · Speaker or chair</span></div></div></section>)}</div></div></section>
  <section class="section"><div class="container"><div class="section__heading"><h2>Program highlights</h2><p>Use these cards only for quick links or high-level categories; detailed schedule information belongs above.</p></div><div class="grid grid--3"><article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="mic" /></span><h3>Keynotes</h3></div><p>Link to speaker details and highlight keynote times.</p><a class="text-link" href={withBase(`/${edition.year}/program/speakers/`)}>View speakers →</a></article><article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="file" /></span><h3>Technical sessions</h3></div><p>Accepted papers, oral sessions and posters placeholder.</p></article><article class="card visual-card"><div class="card__title"><span class="card-icon"><Icon name="users" /></span><h3>Social activities</h3></div><p>Reception, conference dinner or networking activity placeholder.</p></article></div></div></section>
</EditionLayout>
